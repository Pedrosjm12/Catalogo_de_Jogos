DATABASE_URL="file:./dev.db"
PORT=3333
RAWG_API_KEY="SUA_CHAVE_RAWG_AQUI"
# Origens permitidas para o CORS, separadas por vírgula. Se omitido, libera qualquer origem (uso recomendado apenas em dev).
CORS_ORIGIN="http://localhost:5173"
# Chave usada para assinar os tokens JWT de sessão. Gere uma própria em produção (ex: `openssl rand -hex 48`) e nunca reutilize a de exemplo.
JWT_SECRET="SUBSTITUA_POR_UMA_CHAVE_ALEATORIA_LONGA"
JWT_EXPIRES_IN="7d"
