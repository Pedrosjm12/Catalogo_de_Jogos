    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/cors": "^2.8.5",
    "@types/express": "^5.0.0",
    "@types/node": "^22.7.4",
    "tsx": "^4.19.0",
    "typescript": "^5.6.2",
    "vitest": "^2.1.4"
  }
}
